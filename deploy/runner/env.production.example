SERVER_BASE_URL=https://workbench.example.com
RUNNER_SHARED_SECRET=replace-with-the-same-secret-as-the-server
RUNNER_ID=runner-local-mac
RUNNER_NAME=Primary Mac Runner
RUNNER_PLATFORM=macOS
RUNNER_LABELS=mac,primary,codex
RUNNER_CAPABILITIES=codex_app_server,codex_cli,git_guard,xcodebuild
RUNNER_VERSION=0.1.0
RUNNER_HEARTBEAT_INTERVAL_MS=15000
RUNNER_POLL_INTERVAL_MS=4000
RUNNER_GIT_PUSH_TIMEOUT_MS=120000

RUNNER_DATA_ROOT=~/RemoteAgentWorkbenchData
RUNNER_REPO_CACHE_DIR=~/RemoteAgentWorkbenchData/repos
RUNNER_WORKSPACE_DIR=~/RemoteAgentWorkbenchData/worktrees
RUNNER_TASKS_DIR=~/RemoteAgentWorkbenchData/tasks
RUNNER_LOCAL_TASK_RETENTION_DAYS=30
RUNNER_PROJECTS_FILE=~/RemoteAgentWorkbenchData/projects.json
RUNNER_DIRECTORIES_FILE=~/RemoteAgentWorkbenchData/directories.json
RUNNER_LOCK_ROOT_DIR=~/RemoteAgentWorkbenchData/locks
RUNNER_REQUEST_JOURNAL_PATH=~/RemoteAgentWorkbenchData/logs/runner-requests.jsonl

# Optional: leave RUNNER_CODEX_HOME empty to reuse ~/.codex for the current user.
RUNNER_CODEX_HOME=
RUNNER_CODEX_PROFILES_ROOT=~/codex-profiles
RUNNER_CODEX_PROFILE_TEMPLATE=1000
RUNNER_CODEX_RESTART_TIMEOUT_MS=5000
RUNNER_CODEX_RESTART_POLL_INTERVAL_MS=100

GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=

RUNNER_REPORTS_REPO_URL=git@github.com:your-org/remote-agent-reports.git
RUNNER_REPORTS_BRANCH=main
RUNNER_REPORTS_REPO_DIR=~/RemoteAgentWorkbenchData/report-publisher
RUNNER_REPORTS_PUBLIC_BASE_URL=https://github.com/your-org/remote-agent-reports
RUNNER_REPORTS_ROOT_DIR=plans

# Create or edit this file to match your machine before installing the LaunchAgent:
# ~/RemoteAgentWorkbenchData/runner-host.env
