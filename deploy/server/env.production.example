HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://workbench.example.com
CORS_ORIGINS=*
DATA_ROOT=/var/lib/remote-agent-workbench/server
DATABASE_PATH=/var/lib/remote-agent-workbench/server/control-plane.sqlite
TASK_RETENTION_DAYS=30
USER_BEARER_TOKEN=
RUNNER_SHARED_SECRET=replace-with-a-long-random-secret
RUNNER_OFFLINE_THRESHOLD_MS=45000

DEPLOY_SSH_HOST=workbench.example.com
DEPLOY_SSH_USER=root
DEPLOY_DIR=/opt/remote-agent-workbench/server
DEPLOY_ENV_FILE=/opt/remote-agent-workbench/server/.env
DEPLOY_CADDYFILE=/etc/caddy/Caddyfile
