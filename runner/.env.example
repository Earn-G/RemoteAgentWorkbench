SERVER_BASE_URL=http://127.0.0.1:8787
RUNNER_SHARED_SECRET=change-me
RUNNER_ID=runner-local-mac
RUNNER_NAME=Local Mac Runner
RUNNER_PLATFORM=macOS
RUNNER_LABELS=local,mac,codex
RUNNER_CAPABILITIES=codex_app_server,codex_cli,git_guard,xcodebuild
RUNNER_VERSION=0.1.0
RUNNER_HEARTBEAT_INTERVAL_MS=15000
RUNNER_POLL_INTERVAL_MS=4000

# Optional portable runner state directories.
# Leave blank to use defaults under ~/RemoteAgentWorkbenchData.
RUNNER_DATA_ROOT=
RUNNER_REPO_CACHE_DIR=
RUNNER_WORKSPACE_DIR=
RUNNER_CODEX_HOME=
RUNNER_LOCK_ROOT_DIR=
# Legacy setting. Reports now publish at the repository root, so this is ignored.
RUNNER_REPORTS_ROOT_DIR=
